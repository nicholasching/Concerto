{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["bun", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["types/**/*.d.ts", "backend/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tools/**/*.ts", "client-frontend/src/**/*.ts", "client-frontend/src/**/*.tsx", "client-frontend/tests/**/*.ts", "admin-frontend/src/**/*.ts", "admin-frontend/src/**/*.tsx", "admin-frontend/tests/**/*.ts"],
  "exclude": ["beatsync-source", "node_modules", "runtime", "**/.next", "**/dist"]
}
