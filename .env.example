# Local defaults supplied by `bun run dev:all`. Override for a separate concert.
SESSION_ID=dev-session
OPERATOR_SECRET=local-demo-only
HOST=127.0.0.1
PORT=8080
CHECKPOINT_PATH=runtime/local/checkpoint.json
ASSETS_PATH=runtime/local/assets
UPLOADS_PATH=runtime/local/uploads
JOBS_PATH=runtime/local/jobs
# The audience defaults to its own origin; Next proxies participant API/WS to this backend.
BACKEND_INTERNAL_URL=http://127.0.0.1:8080
# For a named Cloudflare hostname, allow that hostname for Next development assets/HMR.
# DEV_ALLOWED_ORIGINS=audience.example.com
# Optional default QR URL; you can also paste/save a tunnel URL in the console without a restart.
# NEXT_PUBLIC_PARTICIPANT_URL=https://audience.example.com
# Set these ONLY for separate API/WS deployments or mock harnesses, not the single-origin tunnel.
# NEXT_PUBLIC_API_URL=https://control.example.com
# NEXT_PUBLIC_WS_URL=wss://control.example.com/ws
# ALLOWED_ORIGINS=https://audience.example.com,https://operator.example.com
# Optional absolute interpreter path; default is the repository .venv.
# PYTHON=/app/.venv/bin/python
