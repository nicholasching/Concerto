HOST=127.0.0.1
PORT=8080
SESSION_ID=dev-session
# Operator credential for admin snapshots and commands. There is no default:
# leaving this unset refuses every operator request. Use a real secret outside development.
OPERATOR_SECRET=
# Durable identity checkpoint. Keep it out of Git and separate per worktree.
CHECKPOINT_PATH=runtime/checkpoint.json
ASSETS_PATH=runtime/assets
UPLOADS_PATH=runtime/uploads
JOBS_PATH=runtime/jobs
# Team 3's real boundary is: python -m otc process --manifest <path> --output <path>.
# For server-capacity testing only, use: bun tools/load/worker-fixture.ts
OTC_COMMAND=python -m otc process
