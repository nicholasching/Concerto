HOST=127.0.0.1
PORT=8080
SESSION_ID=dev-session
# Operator credential for admin snapshots and, later, admin commands. There is no default:
# leaving this unset refuses every operator request. Use a real secret outside development.
OPERATOR_SECRET=
# Durable identity checkpoint. Keep it out of Git and separate per worktree.
CHECKPOINT_PATH=runtime/checkpoint.json
# Media storage remains Team 1 implementation work.
