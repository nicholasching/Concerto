{
  "name": "audience-orchestra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["backend", "client-frontend", "admin-frontend", "packages/*"],
  "scripts": {
    "setup:python": "bun scripts/python.ts setup",
    "contracts:generate": "bun scripts/generate-contracts.ts",
    "contracts:check": "bun scripts/generate-contracts.ts --check",
    "fixtures:generate": "bun scripts/generate-fixtures.ts",
    "fixtures:check": "bun scripts/generate-fixtures.ts --check",
    "test:contracts": "bun test packages/contracts/tests",
    "test:otc": "bun scripts/python.ts test",
    "test:smoke": "bun scripts/smoke.ts",
    "test": "bun run gate",
    "gate": "bun scripts/gate.ts all",
    "gate:sync": "bun scripts/gate.ts sync",
    "gate:client": "bun scripts/gate.ts client",
    "gate:otc": "bun scripts/gate.ts otc",
    "gate:admin": "bun scripts/gate.ts admin",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:isolation": "bun scripts/check-isolation.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint backend client-frontend/src admin-frontend/src packages scripts tools",
    "build": "bun scripts/build.ts all",
    "dev:sync-demo": "bun scripts/dev.ts sync-demo",
    "dev:client-demo": "bun scripts/dev.ts client-demo",
    "dev:admin-demo": "bun scripts/dev.ts admin-demo",
    "dev:all": "bun scripts/dev.ts all",
    "otc:validate": "bun scripts/python.ts validate-manifest --manifest fixtures/otc/clean-30/manifest.json",
    "otc:replay": "bun scripts/python.ts replay-fixture --manifest fixtures/otc/clean-30/manifest.json --fixture fixtures/otc/clean-30/result.json --output runtime/otc/result.json"
  },
  "devDependencies": {
    "@orchestra/contracts": "workspace:*",
    "@orchestra/testkit": "workspace:*",
    "@eslint/js": "9.39.4",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "zod": "4.4.3"
  }
}
